// -*- mode: jsonc -*-
{
    "layer": "top",
    "position": "top",
    "height": 36, // Slightly increased height for better looks
    "margin": "5 10 0 10",
    "spacing": 5,
    
    "modules-left": [
        "hyprland/workspaces",
        "mpris"
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "group/hardware", // Calling the group!
        "custom/calendar",
        "clock",
        "tray",
        "custom/power"
    ],
    
    // Group configuration
    "group/hardware": {
        "orientation": "horizontal",
        "modules": [
            "custom/system",
            "network",
            "pulseaudio",
            "battery"
        ]
    },

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}", // Show name (number)
        "persistent-workspaces": {
            "*": 10
        }
    },

    "clock": {
        "timezone": "Europe/Moscow", // Fixed timezone (Russia/Novosibirsk doesn't work in Waybar)
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format": "{:%H:%M}", // Kept only time (without date) for minimalism
        "format-alt": "{:%Y-%m-%d}"
    },

    "cpu": {
        "format": "{usage}% ",
        "tooltip": false
    },
    
    "memory": {
        "format": "{}% "
    },
    
    "temperature": {
        "critical-threshold": 80,
        "format": "{temperatureC}°C {icon}",
        "format-icons": ["", "", ""]
    },
    
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-full": "{capacity}% {icon}",
        "format-charging": "{capacity}% ",
        "format-plugged": "{capacity}% ",
        "format-icons": ["", "", "", "", ""]
    },
    
    "network": {
        "format-wifi": "{essid} ",
        "format-ethernet": "Ethernet ",
        "tooltip-format": "{ifname} via {gwaddr} ",
        "format-linked": "{ifname} (No IP) ",
        "format-disconnected": "Disconnected ⚠",
        "format-alt": "{ifname}: {ipaddr}/{cidr}",
        "tooltip-format-wifi": "{essid}\nIP: {ipaddr}\nMask: {netmask} (/{cidr})\nSignal: {signalStrength}%\nClick to connect",
        "tooltip-format-disconnected": "Click to connect",
        "on-click": "python3 $HOME/.config/waybar/wifi_popup.py"
    },
    
    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-bluetooth": "{volume}% {icon}",
        "format-bluetooth-muted": " {icon}",
        "format-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "python3 $HOME/.config/waybar/volume_popup.py",
        "on-click-right": "pavucontrol",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },

    "custom/system": {
        "format": "",
        "tooltip": false,
        "on-click": "python3 $HOME/.config/waybar/system_popup.py"
    },

    "custom/calendar": {
        "format": "",
        "tooltip": false,
        "on-click": "python3 $HOME/.config/waybar/calendar_popup.py"
    },
    
    "custom/power": {
        "format" : "⏻",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "$HOME/.config/waybar/power_menu.xml",
        "menu-actions": {
            "shutdown": "shutdown",
            "reboot": "reboot",
            "suspend": "systemctl suspend",
            "hibernate": "systemctl hibernate"
        }
    },

    "mpris": {
        "format": "{player_icon} {artist} - {title}",
        "format-paused": "{status_icon} <i>{artist} - {title}</i>",
        "max-length": 40,
        "player-icons": {
            "default": "▶",
            "spotify": "",
            "firefox": ""
        },
        "status-icons": {
            "paused": "⏸"
        },
        "on-click": "python3 $HOME/.config/waybar/music_popup.py"
    }
}